{
  "name": "red",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "pnpm --filter @red/web dev",
    "dev:scanner": "pnpm --filter @red/scanner dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
